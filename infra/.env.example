# Generate independent random values for each deployment. No real channels may be enabled.
DOMAIN=your-isolated-test-domain.example
PUBLIC_ORIGIN=https://your-isolated-test-domain.example
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_VALUE
DATABASE_URL=postgresql://workshop:REPLACE_WITH_RANDOM_VALUE@db:5432/workshop
APP_ENV=staging
PAYMENT_MODE=mock
LIVE_PROVIDERS=
SESSION_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
MOCK_SIGNING_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
ADMIN_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
TEST_ACCESS_PASSWORD=REPLACE_WITH_RANDOM_16_PLUS_CHARACTERS
MAIL_FROM=workshop@example.test
MAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
STORAGE_ROOT=/data/files
PORT=4100
