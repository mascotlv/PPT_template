APP_ENV=local
PAYMENT_MODE=mock
STORE_ACCESS_MODE=account
# Optional legacy password gate: STORE_ACCESS_MODE=password
PORT=4100
DATABASE_URL=postgresql://workshop:REPLACE@127.0.0.1:5432/workshop
PUBLIC_ORIGIN=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
MOCK_SIGNING_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
ADMIN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
TEST_ACCESS_PASSWORD=REPLACE_WITH_RANDOM_16_PLUS_CHARACTERS
STORAGE_ROOT=./storage
PURCHASE_ROOT=./storage/购买文件
MAIL_TRANSPORT=smtp
# Enable for real registration; tests may use outbox with this disabled.
ACCOUNT_REQUIRE_SMTP=true
# Local development only; false preserves normal registration/login checks.
DEV_AUTH_BYPASS=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=workshop@example.test
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# Optional authenticated SMTP: configure both values and require TLS.
# SMTP_USER=YOUR_SMTP_USERNAME
# SMTP_PASSWORD=YOUR_SMTP_AUTHORIZATION_CODE
OWNER_REFUND_EMAIL=2797687455@qq.com
OWNER_PURCHASE_EMAIL=Gowdybunde@gmail.com
FX_AUTOMATIC_REFRESH=true
# Chat translation can also be configured in Admin > Account. Keys stay on the server.
# GOOGLE_TRANSLATION_KEY=YOUR_GOOGLE_CLOUD_TRANSLATION_KEY
# CHAT_TRANSLATION_URL=https://translate.example.com/translate
# CHAT_TRANSLATION_KEY=YOUR_LIBRETRANSLATE_KEY
