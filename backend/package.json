{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env dist/main.js",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "seed": "node --env-file=.env dist/seed.js",
    "admin:init": "node --env-file=.env dist/admin-init.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit.cjs",
    "commerce:upgrade": "node --env-file=.env dist/commerce-upgrade.js",
    "files:normalize": "node --env-file=.env dist/normalize-files.js"
  },
  "dependencies": {
    "@hyzyla/pdfium": "2.1.13",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "fflate": "0.8.3",
    "helmet": "8.1.0",
    "multer": "2.4.0",
    "nodemailer": "10.0.15",
    "otpauth": "9.5.0",
    "pg": "8.20.0",
    "pptx-glimpse": "5.3.1",
    "pptxgenjs": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "24.12.0",
    "@types/nodemailer": "8.0.2",
    "dotenv": "17.3.1",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}
